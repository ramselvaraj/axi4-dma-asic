[tasks]
bmc
prove
cover
wrap

[options]
bmc: mode bmc
bmc: depth 30
prove: mode prove
prove: depth 40
cover: mode cover
cover: depth 60
wrap: mode bmc
wrap: depth 20

[engines]
bmc: smtbmc boolector
prove: smtbmc yices
cover: smtbmc boolector
wrap: smtbmc boolector

[script]
plugin -i slang
bmc: read_slang -D ACCOUNTING --top dma_rd_engine dma_pkg.sv dma_rd_engine.sv dma_rd_engine_props.sv
prove: read_slang --top dma_rd_engine dma_pkg.sv dma_rd_engine.sv dma_rd_engine_props.sv
cover: read_slang --top dma_rd_engine dma_pkg.sv dma_rd_engine.sv dma_rd_engine_props.sv
wrap: read_slang --top dma_rd_engine dma_pkg.sv dma_rd_engine.sv dma_rd_engine_wrap.sv
prep -top dma_rd_engine
async2sync

[files]
../rtl/dma_pkg.sv
../rtl/dma_rd_engine.sv
dma_rd_engine_props.sv
dma_rd_engine_wrap.sv
